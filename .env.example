# Copy these into your host's environment variables (never commit real keys).
ANTHROPIC_API_KEY=          # Sage's AI answers (api/guide.js)
GUIDE_MODEL=claude-haiku-5-5

# Sage's studio voice (api/tts.js) — set ONE of these providers
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=        # optional; pick a warm voice in your ElevenLabs voice library
OPENAI_API_KEY=
OPENAI_TTS_VOICE=coral

# Staff invitations (api/invite.js, api/rsvp.js)
STAFF_CODE=                 # access code staff enter on the Staff page
RESEND_API_KEY=             # resend.com; verify successbrand.org as a sending domain
INVITE_FROM=Success Brand <invites@successbrand.org>
STAFF_EMAIL_DOMAIN=successbrand.org

ALLOWED_ORIGIN=https://www.successbrand.org
